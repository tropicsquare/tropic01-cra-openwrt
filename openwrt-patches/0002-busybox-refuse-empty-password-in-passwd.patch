From 430b9bfaf6b6994cedad2ec40457f0fa8a5775fd Mon Sep 17 00:00:00 2001
From: kosmax871 <kosmax871@users.noreply.github.com>
Date: Sun, 4 Oct 2026 12:06:30 +0200
Subject: [PATCH] busybox: refuse an empty password in passwd

busybox passwd only applies its weak-password check to non-root, so root
can set an empty password through the tty prompt or piped on stdin (LuCI's
setPassword does exactly that). The result is a valid sha256 hash of the
empty string in /etc/shadow: dropbear, rpcd and login then accept an empty
password, while every check for a "blank" account that looks at an empty
hash field sees a password as set. Seen on an OpenWrt One: the LuCI
first-login password screen accepted an empty password without a warning.

Refuse an empty new password for every caller. "passwd -d" is untouched,
so an account can still be blanked deliberately.

Signed-off-by: kosmax871 <kosmax871@users.noreply.github.com>
---
 ...ginutils-passwd-reject-empty-password.patch | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)
 create mode 100644 package/utils/busybox/patches/610-loginutils-passwd-reject-empty-password.patch

diff --git a/package/utils/busybox/patches/610-loginutils-passwd-reject-empty-password.patch b/package/utils/busybox/patches/610-loginutils-passwd-reject-empty-password.patch
new file mode 100644
index 0000000..3e1fc3e
--- /dev/null
+++ b/package/utils/busybox/patches/610-loginutils-passwd-reject-empty-password.patch
@@ -0,0 +1,18 @@
+--- a/loginutils/passwd.c
++++ b/loginutils/passwd.c
+@@ -67,6 +67,15 @@
+ 	newp = bb_ask_noecho_stdin("New password: "); /* returns malloced str */
+ 	if (!newp)
+ 		goto err_ret;
++	if (newp[0] == '\0') {
++		/* An empty password still hashes to a valid-looking shadow entry,
++		 * so account checks that only test for an empty hash field would
++		 * treat the account as having a password while it accepts "".
++		 * Not limited to non-root like the weak-password check below.
++		 * "passwd -d" is unaffected. */
++		puts("Empty password not allowed");
++		goto err_ret;
++	}
+ 	if (ENABLE_FEATURE_PASSWD_WEAK_CHECK
+ 	 && obscure(orig, newp, pw) /* NB: passing NULL orig is ok */
+ 	 && myuid != 0
-- 
2.34.1

