From: kosmax871 <kosmax871@users.noreply.github.com>
Subject: [PATCH] mediatek: openwrt-one: expose mikroBUS SPI for TROPIC01

Bind spidev to SPI1 chip-select 0 (the mikroBUS socket) and take SPI1_CS
out of the SPI pin mux, so libtropic can drive chip-select as a GPIO.

This replaces the full-file DTS copy carried in the earlier
tropicsquare/openwrt fork. That copy was based on an older revision of
the file and silently reverted five upstream fixes (memory node, user
button polarity, SPI cs-gpios cleanup, {#address,#size}-cells cleanup on
flash and wifi nodes). Only the two TROPIC01-specific hunks are kept.

Signed-off-by: kosmax871 <kosmax871@users.noreply.github.com>
---
--- a/target/linux/mediatek/dts/mt7981b-openwrt-one.dts
+++ b/target/linux/mediatek/dts/mt7981b-openwrt-one.dts
@@ -212,15 +212,14 @@
 	};
 
 	spi1_flash_pins: spi1-pins {
+		/*
+		 * TROPIC01 on mikroBUS: SPI1_CS is left out of the SPI mux so
+		 * libtropic can drive chip-select itself as a plain GPIO
+		 * (/dev/gpiochip0 line 25, see libtropic-pkcs11 TS_GPIO_CS_PIN).
+		 */
 		mux {
 			function = "spi";
-			groups = "spi1_1";
-		};
-
-		conf-pu {
-			pins = "SPI1_CS";
-			drive-strength = <MTK_DRIVE_8mA>;
-			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
+			pins = "SPI1_CLK", "SPI1_MOSI", "SPI1_MISO";
 		};
 
 		conf-pd {
@@ -344,6 +343,17 @@
 	pinctrl-names = "default";
 	pinctrl-0 = <&spi1_flash_pins>;
 	status = "okay";
+
+	/*
+	 * TROPIC01 secure element on the mikroBUS socket, exposed to userspace
+	 * as spidev. "silabs,si3210" is one of the compatibles the spidev
+	 * driver binds to; plain "spidev" is rejected by the kernel.
+	 */
+	mikrobus_spi: spidev@0 {
+		compatible = "silabs,si3210";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+	};
 };
 
 &spi2 {
