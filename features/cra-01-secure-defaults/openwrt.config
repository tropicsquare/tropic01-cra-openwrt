# Annex I 2(b) secure-by-default baseline (firewall/dropbear policy
# assertion + drift warnings). See README.md for what this does and does
# NOT fix.
#
# dropbear and firewall4 ship in the default image regardless (OpenWrt's
# DEFAULT_PACKAGES mechanism), but that's a separate system from Kconfig's
# own dependency resolution: this package's Makefile DEPENDS on both as
# Kconfig symbols, and `make defconfig` silently drops a package whose
# depends aren't explicitly selected in .config, even when the package
# reality-ships anyway. Select them explicitly so this feature's own
# dependency resolves instead of being dropped without any build error.
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_tropic01-secure-defaults=y

# tropic01-console-guard asks rpcd (ubus session login) whether an empty
# password unlocks root, and parses the reply with jsonfilter. Same Kconfig
# reason as above: DEPENDS only resolves if the symbols are selected.
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_jsonfilter=y
