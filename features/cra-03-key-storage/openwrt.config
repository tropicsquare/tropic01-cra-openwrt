# Annex I 2(e) confidentiality: OpenVPN client auth and AWS IoT mTLS, both
# backed by keys generated inside TROPIC01. See README.md.

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_openvpn_openssl=y
CONFIG_PACKAGE_tropic01-aws=y

# The openssl command line, so the owner can make a real certificate signing request (proof that
# the key is in TROPIC01) through pkcs11-provider; see docs/openvpn-user-guide.md.
CONFIG_PACKAGE_openssl-util=y

# Deliberately dropped vs. the original fork's .config.libtropic: the
# mosquitto-client-ssl / libmosquitto-ssl / cJSON / libcares selections
# were left over from before tropic01-aws switched to coreMQTT and are not
# used by anything this feature builds. coreMQTT is pulled in by
# tropic01-aws's PKG_BUILD_DEPENDS, not selected here directly.
