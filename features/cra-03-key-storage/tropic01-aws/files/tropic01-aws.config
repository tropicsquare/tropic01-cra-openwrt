config tropic01-aws main
	# AWS IoT Core endpoint — get it with:
	#   aws iot describe-endpoint --endpoint-type iot:Data-ATS
	option endpoint   ''

	# MQTT port (8883 = standard MQTT over TLS)
	option port       '8883'

	# MQTT topic for outbound telemetry messages
	option topic      'dt/tropic01-router/messages/events/'

	# MQTT client ID — must match the AWS IoT Thing name
	option client_id  'tropic01-router'

	# Amazon Root CA certificate path
	option root_ca    '/etc/ssl/tropic01-aws/AmazonRootCA1.pem'
        # Telemetry topic — used by tropic01-aws-telemetry
        option telemetry_topic  'dt/tropic01-router/telemetry/'

        # Telemetry interval in seconds — used by 'service tropic01-aws start'
        # to install a cron job.  Minimum 60 (1 minute).
        option telemetry_interval  '300'