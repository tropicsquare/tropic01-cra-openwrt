#!/bin/sh
# tropic01-log-recorder -- append filtered system-log lines to a size-capped file.
#
# `logread -F` block-buffers (recent events sit in memory and are lost if the
# board hangs) and its -S does not cap the file, so this writes each line as it
# arrives and rotates by size itself: when the file passes the cap it becomes
# security.log.1 (replacing the older one), so at most about twice the cap is kept.
#
# `logread -f` replays only the last single line of the in-memory log, so
# history logged before this starts would be lost. Start-up therefore:
#   1. starts the follower (its output queues in a FIFO),
#   2. takes a snapshot of the buffer and records what is not stored yet,
#   3. reads the FIFO, dropping leading lines the snapshot already covered.
#
# Usage: tropic01-log-recorder <max-bytes> <logread-filter>
# Test hooks: TROPIC01_LOG (output file), TROPIC01_LOGREAD (the logread to run).
# shellcheck disable=SC3045  # busybox ash supports 'read -t'

LOG="${TROPIC01_LOG:-/etc/tropic01/log/security.log}"
LOGREAD="${TROPIC01_LOGREAD:-logread}"
MAX="${1:-262144}"
FILTER="$2"

mkdir -p "$(dirname "$LOG")"

record() {
	printf '%s\n' "$1" >> "$LOG"
	if [ "$(wc -c < "$LOG")" -gt "$MAX" ]; then
		mv -f "$LOG" "$LOG.1"
	fi
}

FIFO="$(mktemp -u /tmp/tropic01-recorder.XXXXXX)" && mkfifo "$FIFO" || exit 1
SNAP="$(mktemp)" || exit 1
# Read-write open: does not block, and keeps the FIFO from reporting EOF between events.
exec 3<> "$FIFO"
"$LOGREAD" -f -e "$FILTER" >&3 &
LR=$!
cleanup() {
	kill "$LR" 2>/dev/null
	rm -f "$FIFO" "$SNAP" "$SNAP.tail"
}
# A trap that only cleans up would let the loop carry on after procd's SIGTERM.
trap 'cleanup; exit 0' INT TERM
trap cleanup EXIT

# Step 2: history. Skip everything up to the last line already stored, if the
# buffer still holds it (after a reboot it does not, and all of it is new).
"$LOGREAD" -e "$FILTER" > "$SNAP" 2>/dev/null
last="$(tail -n 1 "$LOG" 2>/dev/null)"
awk -v last="$last" '
	{ a[NR] = $0; if (last != "" && $0 == last) idx = NR }
	END { for (i = idx + 1; i <= NR; i++) print a[i] }
' "$SNAP" | while IFS= read -r line; do record "$line"; done
# Step 3: follow. `logread -f` may repeat the last buffered line (only if it matches the
# filter, so it may also repeat nothing). Drop leading lines that the snapshot already
# covered, comparing against its last few lines, and stop deduplicating at the first new one.
# Never wait for a particular line to reappear: it may never come, which would swallow
# every later event.
tail -n 5 "$SNAP" > "$SNAP.tail"
dedupe=1
while :; do
	if IFS= read -r -t 30 line <&3; then
		if [ -n "$dedupe" ]; then
			grep -Fxq -- "$line" "$SNAP.tail" && continue
			dedupe=""
		fi
		record "$line"
	else
		# Timeout (quiet system) or error: leave if the follower has died, so procd restarts us.
		kill -0 "$LR" 2>/dev/null || exit 1
	fi
done
