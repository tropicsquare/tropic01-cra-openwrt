include $(TOPDIR)/rules.mk

PKG_NAME:=tropic01-vault
PKG_VERSION:=0.1.0
PKG_RELEASE:=1

PKG_MAINTAINER:=Tropic Square
PKG_LICENSE:=GPL-2.0-only

include $(INCLUDE_DIR)/package.mk

define Package/tropic01-vault
  SECTION:=utils
  CATEGORY:=Utilities
  TITLE:=CRA Annex I 2(m) encrypted data vault keyed from TROPIC01
  URL:=https://github.com/tropicsquare/tropic01-cra-openwrt
  DEPENDS:=+tropicctl +cryptsetup +kmod-dm +kmod-crypto-xts +kmod-loop +kmod-fs-ext4 +e2fsprogs
endef

define Package/tropic01-vault/description
  A small LUKS2 image mounted at /vault whose 32-byte key is generated by
  TROPIC01's RNG and kept only in an R-MEM slot, never on flash. Destroying
  the vault erases that slot, which makes the encrypted data unrecoverable
  even from a raw flash dump.

  Only data placed in the vault is protected; the rest of the overlay is not
  encrypted. See this feature's README.md for the exact scope and limits.
endef

define Package/tropic01-vault/conffiles
/etc/config/tropic01-vault
endef

define Build/Prepare
	mkdir -p $(PKG_BUILD_DIR)
endef

# Nothing to compile -- scripts and config only.
define Build/Compile
endef

define Package/tropic01-vault/install
	$(INSTALL_DIR) $(1)/etc/config
	$(INSTALL_CONF) ./files/etc/config/tropic01-vault $(1)/etc/config/tropic01-vault
	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) ./files/etc/init.d/tropic01-vault $(1)/etc/init.d/tropic01-vault
	$(INSTALL_DIR) $(1)/usr/sbin
	$(INSTALL_BIN) ./files/usr/sbin/tropic01-vault $(1)/usr/sbin/tropic01-vault
	# enabled by default: S45 symlink, same as `/etc/init.d/... enable` would make
	$(INSTALL_DIR) $(1)/etc/rc.d
	$(LN) ../init.d/tropic01-vault $(1)/etc/rc.d/S45tropic01-vault
	$(LN) ../init.d/tropic01-vault $(1)/etc/rc.d/K15tropic01-vault
endef

$(eval $(call BuildPackage,tropic01-vault))
