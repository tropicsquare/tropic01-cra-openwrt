# Annex I 2(m): the encrypted vault. See README.md for what this does and does NOT do.
# Every dependency is selected explicitly: DEPENDS only resolves if the symbols are
# selected (see cra-01's openwrt.config for the same lesson).
CONFIG_PACKAGE_tropic01-vault=y
CONFIG_PACKAGE_cryptsetup=y
CONFIG_PACKAGE_kmod-dm=y
CONFIG_PACKAGE_kmod-crypto-xts=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
