+/*
+ * Per-unit pairing key (CRA Annex I 2(d)).
+ *
+ * The keys above are the shared engineering-sample pairing key: identical
+ * on every unit, so anyone who has it and bus access can open a secure
+ * session to any chip. If a per-unit key was provisioned into the image,
+ * use it instead:
+ *
+ *   /etc/tropic01/pairing.key   32 raw bytes, private X25519 key
+ *   /etc/tropic01/pairing.pub   32 raw bytes, the matching public key
+ *   /etc/tropic01/pairing.slot  pairing-key slot number 0-3
+ *
+ * No key file at all: warn and keep the shared key (so unprovisioned bench
+ * units still work). Key file present but unusable: fail, never fall back
+ * silently to the shared key.
+ */
+#define PAIRING_KEY_FILE  "/etc/tropic01/pairing.key"
+#define PAIRING_PUB_FILE  "/etc/tropic01/pairing.pub"
+#define PAIRING_SLOT_FILE "/etc/tropic01/pairing.slot"
+
+// Pairing key
+#define PKEY "-k"
+#define PKEY_READ "-r"
+#define PKEY_WRITE "-w"
+#define PKEY_IRREVERSIBLE "--irreversible"
+
+static int read_exact(const char *path, uint8_t *buf, size_t len) {
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        return -1;
+    }
+    size_t n = fread(buf, 1, len, f);
+    int extra = fgetc(f);
+    fclose(f);
+    return (n == len && extra == EOF) ? 0 : -1;
+}
+
+// 1: per-unit key loaded, 0: none provisioned (shared key stays), -1: provisioned but unusable
+static int load_pairing_key(void) {
+    uint8_t priv[sizeof(sh0priv)], pub[sizeof(sh0pub)];
+    char slot_txt[8] = {0};
+
+    // Provisioning only: the per-unit key is not in the chip yet, so the session that writes it
+    // must use the shared key even though the key files may already be on the router.
+    if (getenv("LT_UTIL_FORCE_SHARED_KEY") != NULL) {
+        fprintf(stderr, "lt-util: LT_UTIL_FORCE_SHARED_KEY set, using the shared engineering-sample key\n");
+        return 0;
+    }
+
+    if (access(PAIRING_KEY_FILE, F_OK) != 0) {
+        fprintf(stderr, "lt-util: WARNING: no per-unit pairing key (%s), using the shared engineering-sample key\n",
+                PAIRING_KEY_FILE);
+        return 0;
+    }
+
+    FILE *f = fopen(PAIRING_SLOT_FILE, "r");
+    int slot = -1;
+    if (f) {
+        if (fgets(slot_txt, sizeof(slot_txt), f)) {
+            char *end;
+            long v = strtol(slot_txt, &end, 10);
+            if (end != slot_txt && v >= 0 && v <= 3) {
+                slot = (int)v;
+            }
+        }
+        fclose(f);
+    }
+
+    if (read_exact(PAIRING_KEY_FILE, priv, sizeof(priv)) != 0 || read_exact(PAIRING_PUB_FILE, pub, sizeof(pub)) != 0 ||
+        slot < 0) {
+        fprintf(stderr, "lt-util: ERROR: %s exists but the per-unit key pair is unusable (need 32-byte .key and .pub "
+                        "and a slot 0-3 in .slot); not falling back to the shared key\n", PAIRING_KEY_FILE);
+        memset(priv, 0, sizeof(priv));
+        return -1;
+    }
+
+    memcpy(sh0priv, priv, sizeof(sh0priv));
+    memcpy(sh0pub, pub, sizeof(sh0pub));
+    pkey_index_0 = (int8_t)slot;
+    memset(priv, 0, sizeof(priv));
+    fprintf(stderr, "lt-util: using the per-unit pairing key, slot %d\n", slot);
+    return 1;
+}
