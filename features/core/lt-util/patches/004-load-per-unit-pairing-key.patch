+/*
+ * IRREVERSIBLE. Write a 32-byte public pairing key into an EMPTY slot 1-3.
+ *
+ * A written slot cannot be written again, and the write goes to I-Memory, which on
+ * firmware older than 2.0.0 can fail silently -- so the slot is read back and compared.
+ * Guards: slot 0 (the shared key) is refused, the third argument must be the literal
+ * "--irreversible", the slot must read back EMPTY first, and the file must be exactly
+ * 32 bytes. Run it with LT_UTIL_FORCE_SHARED_KEY=1 so the session uses the shared key.
+ */
+static int process_pairing_write(lt_handle_t *h, char *slot_in, char *file, char *confirm) {
+    if (!slot_in || !file || !confirm) {
+        LT_LOG_ERROR("Error, NULL parameters process_pairing_write()");
+        return 1;
+    }
+    if (strcmp(confirm, PKEY_IRREVERSIBLE) != 0) {
+        LT_LOG_ERROR("This write is irreversible: pass the literal argument "PKEY_IRREVERSIBLE" to confirm");
+        return 1;
+    }
+    char *endptr;
+    long slot = strtol(slot_in, &endptr, 10);
+    if (endptr == slot_in || *endptr != '\0' || slot < 1 || slot > 3) {
+        LT_LOG_ERROR("Error, writable pairing key slots are 1-3 (slot 0 is refused)");
+        return 1;
+    }
+    uint8_t pub[32];
+    if (read_exact(file, pub, sizeof(pub)) != 0) {
+        LT_LOG_ERROR("Error, \"%s\" must be exactly 32 bytes", file);
+        return 1;
+    }
+
+    lt_ret_t ret = lt_init(h);
+    if (ret != LT_OK) {
+        LT_LOG_ERROR("Error lt_init(): %s", lt_ret_verbose(ret));
+        return 1;
+    }
+    ret = lt_verify_chip_and_start_secure_session(h, sh0priv, sh0pub, pkey_index_0);
+    if (ret != LT_OK) {
+        LT_LOG_ERROR("Error sec channel: %s", lt_ret_verbose(ret));
+        lt_deinit(h);
+        return 1;
+    }
+
+    uint8_t existing[32] = {0};
+    ret = lt_pairing_key_read(h, existing, (uint8_t)slot);
+    if (ret != LT_L3_PAIRING_KEY_EMPTY) {
+        LT_LOG_ERROR("Refusing: slot %ld is not empty (read returned %s)", slot, lt_ret_verbose(ret));
+        lt_deinit(h);
+        return 1;
+    }
+
+    ret = lt_pairing_key_write(h, pub, (uint8_t)slot);
+    if (ret != LT_OK) {
+        LT_LOG_ERROR("Error writing pairing key slot %ld: %s", slot, lt_ret_verbose(ret));
+        lt_deinit(h);
+        return 1;
+    }
+
+    uint8_t back[32] = {0};
+    ret = lt_pairing_key_read(h, back, (uint8_t)slot);
+    if (ret != LT_OK || memcmp(back, pub, sizeof(pub)) != 0) {
+        LT_LOG_ERROR("WRITE NOT VERIFIED: slot %ld read-back %s", slot, ret == LT_OK ? "differs" : lt_ret_verbose(ret));
+        lt_deinit(h);
+        return 1;
+    }
+    printf("PAIRING_KEY_WRITTEN_AND_VERIFIED slot=%ld\n", slot);
+
+    lt_deinit(h);
+    return 0;
+}
+
+// Read-only: copy the public pairing key stored in a slot (0-3) to a file.
+static int process_pairing_read(lt_handle_t *h, char *slot_in, char *file) {
+    if (!slot_in || !file) {
+        LT_LOG_ERROR("Error, NULL parameters process_pairing_read()");
+        return 1;
+    } else {
+        LT_LOG_CMD("lt-util "PKEY" "PKEY_READ" %s %s", slot_in, file);
+    }
+
+    char *endptr;
+    long slot = strtol(slot_in, &endptr, 10);
+    if (endptr == slot_in || *endptr != '\0' || slot < 0 || slot > 3) {
+        LT_LOG_ERROR("Error, pairing key slot must be 0-3");
+        return 1;
+    }
+
+    lt_ret_t ret = lt_init(h);
+    if (ret != LT_OK) {
+        LT_LOG_ERROR("Error lt_init(): %s", lt_ret_verbose(ret));
+        return 1;
+    }
+    ret = lt_verify_chip_and_start_secure_session(h, sh0priv, sh0pub, pkey_index_0);
+    if (ret != LT_OK) {
+        LT_LOG_ERROR("Error sec channel: %s", lt_ret_verbose(ret));
+        lt_deinit(h);
+        return 1;
+    }
+
+    uint8_t pub[32] = {0};
+    ret = lt_pairing_key_read(h, pub, (uint8_t)slot);
+    if (ret != LT_OK) {
+        LT_LOG_ERROR("Error reading pairing key slot %ld: %s", slot, lt_ret_verbose(ret));
+        lt_deinit(h);
+        return 1;
+    }
+
+    FILE *fp = fopen(file, "wb");
+    if (fp == NULL || fwrite(pub, 1, sizeof(pub), fp) != sizeof(pub)) {
+        LT_LOG_ERROR("Error writing file \"%s\"", file);
+        if (fp) {
+            fclose(fp);
+        }
+        lt_deinit(h);
+        return 1;
+    }
+    fclose(fp);
+    LT_LOG_INFO("Wrote the 32-byte public pairing key of slot %ld into \"%s\"", slot, file);
+
+    lt_deinit(h);
+    return 0;
+}
