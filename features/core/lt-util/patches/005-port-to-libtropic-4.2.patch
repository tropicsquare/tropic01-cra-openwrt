+# lt-util for TROPIC01 on a Linux SPI/GPIO board (OpenWrt One).
+# libtropic is not bundled: pass its source tree (the OpenWrt package installs
+# it under usr/src/libtropic) with -DLIBTROPIC_SRC=<path>.
+set(LIBTROPIC_SRC "" CACHE PATH "Path to the libtropic source tree")
+if(NOT LIBTROPIC_SRC OR NOT EXISTS "${LIBTROPIC_SRC}/CMakeLists.txt")
+    message(FATAL_ERROR "Set -DLIBTROPIC_SRC to a libtropic source tree")
+endif()
+
+project(lt_util VERSION 0.1.0 DESCRIPTION "TROPIC01 command line utility" LANGUAGES C)
+
+add_subdirectory(${LIBTROPIC_SRC} libtropic)
+
+# OpenSSL crypto abstraction layer and the Linux SPI/GPIO hardware layer
+find_package(OpenSSL REQUIRED)
+add_subdirectory(${LIBTROPIC_SRC}/cal/openssl cal_openssl)
+target_sources(tropic PRIVATE ${LT_CAL_SRCS})
+target_include_directories(tropic PUBLIC ${LT_CAL_INC_DIRS})
+target_link_libraries(tropic PUBLIC OpenSSL::Crypto)
+add_subdirectory(${LIBTROPIC_SRC}/hal/linux/spi linux_spi_hal)
+target_sources(tropic PRIVATE ${LT_HAL_SRCS})
+target_include_directories(tropic PUBLIC ${LT_HAL_INC_DIRS})
+
+add_executable(lt-util src/main.c src/macandd.c)
+# macandd.c uses libtropic's HMAC helper, which is not a public header
+target_include_directories(lt-util PRIVATE ${LIBTROPIC_SRC}/src)
+target_compile_definitions(lt-util PRIVATE LINUX_SPI=1)
+target_link_libraries(lt-util PRIVATE tropic)
