# TROPIC01 platform layer: libtropic -> PKCS#11 module -> lt-util CLI.
# See README.md for the package list and the R-MEM/ECC slot layout.

CONFIG_PACKAGE_libtropic=y
CONFIG_PACKAGE_libtropic-pkcs11=y
CONFIG_PACKAGE_lt-util=y
CONFIG_PACKAGE_pkcs11-helper=y
CONFIG_PACKAGE_pkcs11-provider=y
CONFIG_PACKAGE_spidev-test=y
CONFIG_PACKAGE_kmod-usb-acm=y

CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_WITH_DEPRECATED=y

# opensc, pkcs11-test and libtropic-pkcs11-test are deliberately NOT
# selected here. opensc is known to fail against OpenWrt's fortify
# headers (see README "What this does NOT fix"); the two test tools are
# optional diagnostics, not part of the image -- build them one-off with
# `make package PKG=pkcs11-test` when needed.

# Deliberately dropped vs. the original fork's .config.libtropic:
# CONFIG_OPENSSL_WITH_{IDEA,MDC2,SEED,SRP,WHIRLPOOL}: legacy ciphers,
# unneeded attack surface for this project. Re-add only if a dependency
# turns out to need one, and say which.
