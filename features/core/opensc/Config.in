config PACKAGE_opensc
	bool "opensc - Smart card utilities (pkcs11-tool)"
	depends on PACKAGE_libopensc
	default n
	help
	  OpenSC provides utilities to work with smart cards and PKCS#11 modules.
	  
	  This minimal build includes:
	  - pkcs11-tool: Test and debug PKCS#11 modules
	  - opensc-tool: Query smart card information
	  - pkcs15-tool: Manage PKCS#15 data
	  
	  Built without PC/SC middleware for reduced dependencies.
	  Perfect for testing PKCS#11 modules like libtropic-pkcs11.
	  
	  https://github.com/OpenSC/OpenSC

config PACKAGE_libopensc
	bool "libopensc - OpenSC PKCS#11 library"
	select PACKAGE_libopenssl
	select PACKAGE_zlib
	default n
	help
	  OpenSC libraries for PKCS#11 and smart card operations.
	  
	  This is a minimal build without PC/SC middleware support,
	  suitable for use with external PKCS#11 modules.
