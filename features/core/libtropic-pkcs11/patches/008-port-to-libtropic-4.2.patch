Port libtropic-pkcs11 to libtropic 4.2.0.

Build against the one libtropic source tree the feed pins (-DLIBTROPIC_SRC),
not the older copy bundled as a submodule. Changes: the engineering-sample
pairing key symbols got an lt_ prefix, TR01_CURVE_GENERATED became
TR01_KEY_GENERATED, and signing uses lt_ecc_ecdsa_sign(), which in 4.x takes
a 32-byte hash and does not hash again (this replaces the local
lt_ecc_ecdsa_sign_prehash() that patch 005 added to the bundled copy). A
digest longer than 32 bytes is cut to its leftmost 32 bytes; a shorter one is
refused with CKR_DATA_LEN_RANGE instead of being hashed or padded.

--- a/CMakeLists.txt	2026-10-09 18:27:14.235078090 +0200
+++ b/CMakeLists.txt	2026-10-09 18:27:14.250078298 +0200
@@ -20,7 +20,12 @@
 ###############################################################################
 
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-set(PATH_LIBTROPIC ${CMAKE_CURRENT_SOURCE_DIR}/libtropic/)
+# libtropic is not bundled: the OpenWrt package passes the pinned libtropic source tree.
+set(LIBTROPIC_SRC "" CACHE PATH "Path to the libtropic source tree")
+if(NOT LIBTROPIC_SRC OR NOT EXISTS "${LIBTROPIC_SRC}/CMakeLists.txt")
+    message(FATAL_ERROR "Set -DLIBTROPIC_SRC to a libtropic source tree")
+endif()
+set(PATH_LIBTROPIC ${LIBTROPIC_SRC}/)
 
 ###############################################################################
 # Print info
