-#define LT_PKCS11_SH0_PRIV sh0priv_eng_sample
-#define LT_PKCS11_SH0_PUB sh0pub_eng_sample
+#define LT_PKCS11_SH0_PRIV lt_sh0priv_eng_sample
+#define LT_PKCS11_SH0_PUB lt_sh0pub_eng_sample
 
 /*
  * Per-unit pairing key (CRA Annex I 2(d)).
@@ -1275,7 +1275,7 @@
                 LT_PKCS11_LOG("CKA_LOCAL");
 
                 /* Keys generated on chip are local */
-                CK_BBOOL is_local = (origin == TR01_CURVE_GENERATED) ? CK_TRUE : CK_FALSE;
+                CK_BBOOL is_local = (origin == TR01_KEY_GENERATED) ? CK_TRUE : CK_FALSE;
                 if (pTemplate[i].pValue == NULL) {
                     pTemplate[i].ulValueLen = sizeof(CK_BBOOL);
                 } else if (pTemplate[i].ulValueLen >= sizeof(CK_BBOOL)) {
@@ -1849,24 +1849,19 @@
         LT_PKCS11_INFO("ECDSA/P-256 sign: %lu-byte hash -> TROPIC01 key slot %u (private key never leaves chip)",
                        ulDataLen, pkcs11_ctx.sign_key_slot);
         /*
-         * CKM_ECDSA: caller passes a pre-computed hash (typically 32-byte SHA-256).
-         * Use lt_ecc_ecdsa_sign_prehash() to send the hash directly to the hardware
-         * without the internal SHA-256 step (avoids double-hashing).
+         * CKM_ECDSA: the caller passes a pre-computed hash. libtropic 4.x signs exactly a
+         * 32-byte hash and does not hash again. A longer digest is cut to its leftmost 32
+         * bytes, as ECDSA specifies for P-256; a shorter one is refused, never padded.
          */
-        lt_ret_t ret;
-        if (ulDataLen == 32) {
-            ret = lt_ecc_ecdsa_sign_prehash(&pkcs11_ctx.lt_handle,
-                                            (lt_ecc_slot_t)pkcs11_ctx.sign_key_slot,
-                                            pData, pSignature);
-        } else {
-            /* Longer data - hash it internally (legacy/non-standard use) */
-            ret = lt_ecc_ecdsa_sign(&pkcs11_ctx.lt_handle,
-                                    (lt_ecc_slot_t)pkcs11_ctx.sign_key_slot,
-                                    pData, ulDataLen, pSignature);
+        if (ulDataLen < 32) {
+            LT_PKCS11_RETURN(CKR_DATA_LEN_RANGE);
         }
+        lt_ret_t ret = lt_ecc_ecdsa_sign(&pkcs11_ctx.lt_handle,
+                                         (lt_ecc_slot_t)pkcs11_ctx.sign_key_slot,
+                                         pData, 32, pSignature);
 
         if (ret != LT_OK) {
-            LT_PKCS11_LOG("lt_ecc_ecdsa_sign(_prehash) failed: %s", lt_ret_verbose(ret));
+            LT_PKCS11_LOG("lt_ecc_ecdsa_sign failed: %s", lt_ret_verbose(ret));
             LT_PKCS11_RETURN(CKR_DEVICE_ERROR);
         }
 
