 #define LT_PKCS11_SH0_PUB sh0pub_eng_sample
 
 /*
+ * Per-unit pairing key (CRA Annex I 2(d)).
+ *
+ * The macros above are the shared engineering-sample pairing key, identical
+ * on every unit. If the image carries a per-unit key pair, use it instead:
+ *
+ *   /etc/tropic01/pairing.key   32 raw bytes, private X25519 key
+ *   /etc/tropic01/pairing.pub   32 raw bytes, the matching public key
+ *   /etc/tropic01/pairing.slot  pairing-key slot number 0-3
+ *
+ * No key file at all: warn and keep the shared key, so unprovisioned bench
+ * units still work. Key file present but unusable: fail, never fall back
+ * silently to the shared key.
+ */
+#define LT_PKCS11_PAIRING_KEY_FILE  "/etc/tropic01/pairing.key"
+#define LT_PKCS11_PAIRING_PUB_FILE  "/etc/tropic01/pairing.pub"
+#define LT_PKCS11_PAIRING_SLOT_FILE "/etc/tropic01/pairing.slot"
+
+static int lt_pkcs11_read_exact(const char *path, uint8_t *buf, size_t len)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        return -1;
+    }
+    size_t n = fread(buf, 1, len, f);
+    int extra = fgetc(f);
+    fclose(f);
+    return (n == len && extra == EOF) ? 0 : -1;
+}
+
+/* 1: per-unit key loaded, 0: none provisioned (shared key stays), -1: provisioned but unusable */
+static int lt_pkcs11_load_pairing_key(uint8_t priv[32], uint8_t pub[32], uint8_t *slot)
+{
+    char slot_txt[8] = {0};
+    int slot_val = -1;
+
+    if (access(LT_PKCS11_PAIRING_KEY_FILE, F_OK) != 0) {
+        syslog(LOG_WARNING, "tropic-pkcs11: no per-unit pairing key (%s), using the shared engineering-sample key",
+               LT_PKCS11_PAIRING_KEY_FILE);
+        return 0;
+    }
+
+    FILE *f = fopen(LT_PKCS11_PAIRING_SLOT_FILE, "r");
+    if (f) {
+        if (fgets(slot_txt, sizeof(slot_txt), f)) {
+            char *end;
+            long v = strtol(slot_txt, &end, 10);
+            if (end != slot_txt && v >= 0 && v <= 3) {
+                slot_val = (int)v;
+            }
+        }
+        fclose(f);
+    }
+
+    if (lt_pkcs11_read_exact(LT_PKCS11_PAIRING_KEY_FILE, priv, 32) != 0 ||
+        lt_pkcs11_read_exact(LT_PKCS11_PAIRING_PUB_FILE, pub, 32) != 0 || slot_val < 0) {
+        syslog(LOG_ERR, "tropic-pkcs11: %s exists but the per-unit key pair is unusable (need 32-byte .key and .pub "
+                        "and a slot 0-3 in .slot); not falling back to the shared key",
+               LT_PKCS11_PAIRING_KEY_FILE);
+        memset(priv, 0, 32);
+        return -1;
+    }
+
+    *slot = (uint8_t)slot_val;
+    return 1;
+}
+
