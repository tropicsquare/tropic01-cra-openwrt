+/**************************************************************************************************
+ * Device info helper
+ *************************************************************************************************/
+
+/**
+ * @brief Read TROPIC01 chip info and log it to syslog (OpenWrt web UI visible).
+ *
+ * Called once after lt_init() succeeds in C_Initialize.  The L2 transport is
+ * open at that point so lt_get_info_* commands reach the chip without needing
+ * a full secure session.
+ */
+static void lt_pkcs11_log_tropic01_info(lt_handle_t *handle)
+{
+    uint8_t fw_ver[4] = {0};
+    struct lt_chip_id_t chip_id = {0};
+    char model[17] = {0};
+    char serial[15] = {0};
+    lt_ret_t ret;
+
+    /* RISC-V application firmware version */
+    ret = lt_get_info_riscv_fw_ver(handle, fw_ver);
+    if (ret == LT_OK) {
+        LT_PKCS11_INFO("RISC-V firmware v%u.%u.%u.%u",
+                       fw_ver[3], fw_ver[2], fw_ver[1], fw_ver[0]);
+    } else {
+        syslog(LOG_WARNING, "tropic-pkcs11: failed to read RISC-V FW version: %s",
+               lt_ret_verbose(ret));
+    }
+
+    /* SPECT cryptographic co-processor firmware version */
+    ret = lt_get_info_spect_fw_ver(handle, fw_ver);
+    if (ret == LT_OK) {
+        LT_PKCS11_INFO("SPECT firmware v%u.%u.%u.%u",
+                       fw_ver[3], fw_ver[2], fw_ver[1], fw_ver[0]);
+    } else {
+        syslog(LOG_WARNING, "tropic-pkcs11: failed to read SPECT FW version: %s",
+               lt_ret_verbose(ret));
+    }
+
+    /* Chip identity: model, serial number, hardware revision */
+    ret = lt_get_info_chip_id(handle, &chip_id);
+    if (ret == LT_OK) {
+        /* part_num_data is a length-prefixed ASCII string, e.g. "TR01-C2P-T101" */
+        if (chip_id.part_num_data[0] > 0 && chip_id.part_num_data[0] < 16) {
+            uint8_t len = chip_id.part_num_data[0];
+            if (len > 16) len = 16;
+            memcpy(model, &chip_id.part_num_data[1], len);
+        } else {
+            strncpy(model, "TROPIC01", sizeof(model) - 1);
+        }
+        /* Serial: batch_id (5 bytes) + lot_id (2 bytes) = 14 hex chars */
+        snprintf(serial, sizeof(serial), "%02X%02X%02X%02X%02X%02X%02X",
+                 chip_id.batch_id[0], chip_id.batch_id[1], chip_id.batch_id[2],
+                 chip_id.batch_id[3], chip_id.batch_id[4],
+                 chip_id.ser_num.lot_id[0], chip_id.ser_num.lot_id[1]);
+        LT_PKCS11_INFO("chip model=%s serial=%s HW-rev=%u.%u",
+                       model, serial,
+                       chip_id.chip_id_ver[0], chip_id.chip_id_ver[1]);
+    } else {
+        syslog(LOG_WARNING, "tropic-pkcs11: failed to read chip ID: %s",
+               lt_ret_verbose(ret));
+    }
+
+    LT_PKCS11_INFO("interface: SPI %s | GPIO %s | CS-pin %d | speed %d Hz",
+                   TS_SPI_DEV, TS_GPIO_DEV, TS_GPIO_CS_PIN, TS_SPI_SPEED);
+}
 
 
