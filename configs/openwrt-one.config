# Base configuration: OpenWrt One board + TROPIC01 SPI enablement.
# Feature-specific packages are NOT listed here -- each feature adds its
# own fragment at features/<feature>/openwrt.config, which
# scripts/prepare.sh appends before running `make defconfig`.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_openwrt_one=y

# spidev for the mikroBUS SPI node added by openwrt-patches/0001-*
CONFIG_PACKAGE_kmod-spi-dev=y

# CycloneDX SBOM next to the image (CRA Annex I Part II: identify and
# document components). Written to bin/targets/.../*.bom.cdx.json.
CONFIG_JSON_CYCLONEDX_SBOM=y

# Web UI (LuCI over uhttpd) with HTTPS support (mbedtls, self-signed cert).
# Part of the default image so the web side of first-login and password
# handling can be tested. It is also extra LAN-side attack surface and the
# source of the stock "no password" web behaviour: see
# features/cra-01-secure-defaults/README.md ("First-login web page").
# luci-ssl pulls luci-light, libustream-mbedtls and px5g-mbedtls.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
